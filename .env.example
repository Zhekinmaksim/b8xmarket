# Copy to .env.local and fill locally. Never commit real values.

BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Burner wallets only. Do not use a main wallet.
# Prefer one wallet per agent/category.
B8X_REBALANCER_PRIVATE_KEY=
B8X_GRID_PRIVATE_KEY=
B8X_YIELD_PRIVATE_KEY=
B8X_HEALTH_PRIVATE_KEY=

# Optional services, only if used by the agent runtime.
PIEVERSE_LLM_API_KEY=
WALLET_PASSWORD=
